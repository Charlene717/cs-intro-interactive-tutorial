<script src="i18n.js"></script>
<script>
window.addEventListener('scroll',()=>{const h=document.documentElement;document.getElementById('progressBar').style.width=(h.scrollTop/(h.scrollHeight-h.clientHeight))*100+'%';});
function switchTab(b,id){const p=b.closest('.code-tabs');p.querySelectorAll('.code-tab-btn').forEach(x=>x.classList.remove('active'));p.querySelectorAll('.code-tab-content').forEach(x=>x.classList.remove('active'));b.classList.add('active');document.getElementById(id).classList.add('active');}

// Latency chart (log scale, nanoseconds)
const latencyLabels = ['Register','L1','L2','L3','HBM3e','DRAM','NVMe SSD','SATA SSD','HDD','Tape (load)'];
const latencyNs     = [0.3, 1, 3, 10, 20, 80, 50_000, 200_000, 5_000_000, 60_000_000_000];
new Chart(document.getElementById('latencyChart'),{
  type:'bar',
  data:{labels:latencyLabels,datasets:[{label:'Access latency (ns, log scale)',data:latencyNs,
    backgroundColor:latencyNs.map(v=>v<100?'rgba(22,163,74,.8)':v<1e5?'rgba(218,165,32,.85)':'rgba(220,38,38,.8)'),
    borderColor:'rgba(15,23,42,.4)',borderWidth:1}]},
  options:{responsive:true,maintainAspectRatio:false,
    plugins:{legend:{display:false},tooltip:{callbacks:{label:(c)=>{
      const v=c.parsed.y;
      if(v<1000) return v+' ns';
      if(v<1e6)  return (v/1000).toFixed(1)+' µs';
      if(v<1e9)  return (v/1e6).toFixed(1)+' ms';
      return (v/1e9).toFixed(1)+' s';
    }}}},
    scales:{y:{type:'logarithmic',title:{display:true,text:'Latency (nanoseconds, log)'},min:0.1,max:1e11}}}
});

// Cache locality simulator
const grid = document.getElementById('cacheGrid');
const GRID_N = 8;
let mode = 'row';
let cells = [];
let cachedLine = -1;  // which row currently in cache (1 line cache for demo)
let hits = 0, misses = 0;
let cursor = 0;  // index 0..63

function buildGrid(){
  grid.innerHTML='';
  cells=[];
  for(let r=0;r<GRID_N;r++){
    for(let c=0;c<GRID_N;c++){
      const d=document.createElement('div');
      d.style.cssText='width:32px;height:32px;border:1px solid #cbd5e1;border-radius:4px;background:#fff;font-size:.7rem;display:flex;align-items:center;justify-content:center;color:#94a3b8;font-family:monospace;transition:all .25s';
      d.textContent=r*GRID_N+c;
      cells.push(d);
      grid.appendChild(d);
    }
  }
}
function resetSim(){cachedLine=-1;hits=0;misses=0;cursor=0;updateStats();buildGrid();}
function updateStats(){
  document.getElementById('hitCount').textContent=hits;
  document.getElementById('missCount').textContent=misses;
  const total=hits+misses;
  const rate=total===0?0:Math.round(hits/total*100);
  document.getElementById('hitRate').textContent=rate+'%';
  document.getElementById('hitRateEn').textContent=rate+'%';
}
function step(){
  if(cursor>=GRID_N*GRID_N) return;
  let r,c;
  if(mode==='row'){ r=Math.floor(cursor/GRID_N); c=cursor%GRID_N; }
  else            { c=Math.floor(cursor/GRID_N); r=cursor%GRID_N; }
  const idx=r*GRID_N+c;
  const isHit = (cachedLine===r);
  if(isHit){ hits++; cells[idx].style.background='#bbf7d0'; cells[idx].style.color='#166534'; }
  else     { misses++; cells[idx].style.background='#fecaca'; cells[idx].style.color='#991b1b'; cachedLine=r;
             // highlight new cache line
             for(let cc=0;cc<GRID_N;cc++){ if(cc!==c){ cells[r*GRID_N+cc].style.background='#fef9c3'; } }
           }
  cells[idx].style.fontWeight='700';
  cursor++;
  updateStats();
}
document.getElementById('modeRow').onclick=()=>{mode='row';document.getElementById('modeRow').classList.add('active');document.getElementById('modeCol').classList.remove('active');resetSim();};
document.getElementById('modeCol').onclick=()=>{mode='col';document.getElementById('modeCol').classList.add('active');document.getElementById('modeRow').classList.remove('active');resetSim();};
document.getElementById('resetSim').onclick=resetSim;
document.getElementById('stepBtn').onclick=step;
document.getElementById('autoBtn').onclick=()=>{const t=setInterval(()=>{if(cursor>=GRID_N*GRID_N){clearInterval(t);return;}step();},80);};
buildGrid();

// Quiz
const QF={zh:{
q1_y:'絕大多數 x86/ARM CPU 的 cache line 都是 64 byte。',q1_n:'答案 B (64 B)。',
q2_y:'TLB 是 page table 的 cache，沒有它每次存取都要走慢速 page-table walk。',q2_n:'答案 C。',
q3_y:'row-major 表示同一列元素在記憶體中連續，按欄走會每次跨 N×4 byte → 不命中 cache。',q3_n:'答案 D。',
q4_y:'人類基因組 suffix array + junction database ~25 GB；演算法需 O(1) 隨機存取，必須全載入 DRAM。',q4_n:'答案 B。',
q5_y:'HBM3 (3.35 TB/s) 比 HBM2e (2 TB/s) 頻寬高，memory-bound 工作直接受益。',q5_n:'答案 A。'
},en:{
q1_y:'64 bytes is standard for nearly all x86/ARM CPUs.',q1_n:'Answer: B.',
q2_y:'TLB caches page-table entries — without it, every access would do a slow page-table walk.',q2_n:'Answer: C.',
q3_y:'Row-major means row elements are contiguous; column traversal strides N×4 bytes, missing the cache.',q3_n:'Answer: D.',
q4_y:'Suffix array + junction DB ≈ 25 GB; algorithm needs O(1) random access, so it must live in DRAM.',q4_n:'Answer: B.',
q5_y:'HBM3 (3.35 TB/s) has higher bandwidth than HBM2e (2 TB/s); bandwidth-bound jobs benefit directly.',q5_n:'Answer: A.'
}};
document.querySelectorAll('.quiz-q').forEach((q,qi)=>{const ans=+q.dataset.answer;q.querySelectorAll('.quiz-opt').forEach(o=>{o.addEventListener('click',()=>{if(q.classList.contains('answered'))return;q.classList.add('answered');const fb=document.getElementById('fb'+(qi+1));const ok=+o.dataset.idx===ans;o.classList.add(ok?'correct':'wrong');if(!ok)q.querySelectorAll('.quiz-opt')[ans].classList.add('correct');const L=I18n.get();fb.className='quiz-feedback show '+(ok?'correct-fb':'wrong-fb');fb.textContent=(ok?'✅ ':'❌ ')+(QF[L]['q'+(qi+1)+'_'+(ok?'y':'n')]||'');});});});
</script>
</body></html>
